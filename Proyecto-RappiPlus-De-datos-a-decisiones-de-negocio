    "    usuarios_first_visit,\n",
    "    usuarios_select_item,\n",
    "    usuarios_add_to_cart,\n",
    "    usuarios_begin_checkout,\n",
    "    usuarios_add_payment_info,\n",
    "    usuarios_purchase,\n",
    "    ROUND(usuarios_select_item * 100.0 / NULLIF(usuarios_first_visit, 0), 2) AS pct_select_item,\n",
    "    ROUND(usuarios_add_to_cart * 100.0 / NULLIF(usuarios_first_visit, 0), 2) AS pct_add_to_cart,\n",

    "query_conversion = '''\n",
    "\n",
    "WITH first_visits AS (\n",
    "  SELECT DISTINCT id_usuario, pais\n",
    "  FROM events\n",
    "  WHERE nombre_evento = 'first_visit'\n",
    "),\n",
    "select_item AS (\n",
    "  SELECT DISTINCT id_usuario, pais\n",
    "  FROM events\n",
    "  WHERE nombre_evento = 'select_item'\n",
    "),\n",
    "add_to_cart AS (\n",
    "  SELECT DISTINCT id_usuario, pais\n",
    "  FROM events\n",
    "  WHERE nombre_evento = 'add_to_cart'\n",
    "),\n",
    "begin_checkout AS (\n",
    "  SELECT DISTINCT id_usuario, pais\n",
    "  FROM events\n",
    "  WHERE nombre_evento = 'begin_checkout'\n",
    "),\n",
    "add_payment_info AS (\n",
    "  SELECT DISTINCT id_usuario, pais\n",
    "  FROM events\n",
    "  WHERE nombre_evento = 'add_payment_info'\n",
    "),\n",
    "purchase AS (\n",
    "  SELECT DISTINCT id_usuario, pais\n",
    "  FROM events\n",
    "  WHERE nombre_evento = 'purchase'\n",
    "),\n",
    "funnel_counts AS (\n",
    "  SELECT\n",
    "    fv.pais,  \n",
    "    COUNT(fv.id_usuario) AS usuarios_first_visit,\n",
    "    COUNT(si.id_usuario) AS usuarios_select_item,\n",
    "    COUNT(a.id_usuario) AS usuarios_add_to_cart,\n",
    "    COUNT(bc.id_usuario) AS usuarios_begin_checkout,\n",
    "    COUNT(api.id_usuario) AS usuarios_add_payment_info,\n",
    "    COUNT(p.id_usuario) AS usuarios_purchase\n",
    "  FROM first_visits fv\n",
    "  LEFT JOIN select_item si        \n",
    "      ON fv.id_usuario = si.id_usuario AND fv.pais = si.pais\n",
    "  LEFT JOIN add_to_cart a         \n",
    "      ON fv.id_usuario = a.id_usuario AND fv.pais = a.pais\n",
    "  LEFT JOIN begin_checkout bc     \n",
    "      ON fv.id_usuario = bc.id_usuario AND fv.pais = bc.pais\n",
    "  LEFT JOIN add_payment_info api  \n",
    "      ON fv.id_usuario = api.id_usuario AND fv.pais = api.pais\n",
    "  LEFT JOIN purchase p            \n",
    "      ON fv.id_usuario = p.id_usuario AND fv.pais = p.pais\n",
    "  GROUP BY fv.pais\n",
    ")\n",

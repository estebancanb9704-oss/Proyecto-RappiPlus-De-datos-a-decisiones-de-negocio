    "    ROUND(usuarios_purchase * 100.0 / NULLIF(usuarios_first_visit, 0), 2) AS pct_purchase\n",
    "FROM funnel_counts\n",
    "ORDER BY pct_purchase DESC;\n",
    "'''\n",
    "\n",

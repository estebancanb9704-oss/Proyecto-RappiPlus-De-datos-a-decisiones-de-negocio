   "source": [
    "# Retención por cohortes\n",
    "# ======================\n",
    "\n",
    "query_cohort_retention_final = '''\n",
    "\n",
    "WITH cohort AS (\n",
    "    SELECT\n",
    "        id_usuario,\n",
    "        TO_CHAR(DATE_TRUNC('month', MIN(CAST(fecha_registro AS DATE))), 'YYYY-MM') AS cohort\n",
    "    FROM users\n",
    "    GROUP BY id_usuario\n",
    "),\n",
    "activity AS (\n",
    "    SELECT \n",
    "        u.id_usuario, \n",
    "        c.cohort, \n",
    "        ua.dias_despues_registro,\n",
    "        ua.activo\n",
    "    FROM users u\n",
    "    LEFT JOIN cohort c \n",
    "        ON u.id_usuario = c.id_usuario\n",
    "    LEFT JOIN user_activity ua \n",
    "        ON u.id_usuario = ua.id_usuario\n",
    ")\n",
    "SELECT \n",
    "    cohort,\n",
    "    COUNT(DISTINCT id_usuario) AS usuarios_cohorte,\n",
    "    \n",
    "    COUNT(DISTINCT CASE WHEN dias_despues_registro >= 7 AND activo = 1 THEN id_usuario END) AS retenidos_d7,\n",
    "    COUNT(DISTINCT CASE WHEN dias_despues_registro >= 14 AND activo = 1 THEN id_usuario END) AS retenidos_d14,\n",
    "    COUNT(DISTINCT CASE WHEN dias_despues_registro >= 21 AND activo = 1 THEN id_usuario END) AS retenidos_d21,\n",
    "    COUNT(DISTINCT CASE WHEN dias_despues_registro >= 28 AND activo = 1 THEN id_usuario END) AS retenidos_d28,\n",
    "    \n",
    "    ROUND(\n",
    "      COUNT(DISTINCT CASE WHEN dias_despues_registro >= 7 AND activo = 1 THEN id_usuario END) * 100.0 \n",
    "      / NULLIF(COUNT(DISTINCT id_usuario), 0), 1\n",
    "    ) AS retention_d7_pct,\n",
    "    \n",
    "    ROUND(\n",
    "      COUNT(DISTINCT CASE WHEN dias_despues_registro >= 14 AND activo = 1 THEN id_usuario END) * 100.0 \n",
    "      / NULLIF(COUNT(DISTINCT id_usuario), 0), 1\n",
    "    ) AS retention_d14_pct,\n",
    "    \n",
    "    ROUND(\n",
    "      COUNT(DISTINCT CASE WHEN dias_despues_registro >= 21 AND activo = 1 THEN id_usuario END) * 100.0 \n",
    "      / NULLIF(COUNT(DISTINCT id_usuario), 0), 1\n",
    "    ) AS retention_d21_pct,\n",
    "    \n",
    "    ROUND(\n",
    "      COUNT(DISTINCT CASE WHEN dias_despues_registro >= 28 AND activo = 1 THEN id_usuario END) * 100.0 \n",
    "      / NULLIF(COUNT(DISTINCT id_usuario), 0), 1\n",
    "    ) AS retention_d28_pct\n",
    "\n",
    "FROM activity\n",
    "GROUP BY cohort\n",
    "ORDER BY cohort;\n",
    "'''\n",
    "\n",
    "# Ejecutar la consulta\n",
    "cohorte_final = pd.read_sql(query_cohort_retention_final, con=engine)\n",
    "cohorte_final"
   ]
